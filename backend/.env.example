# Database Configuration
POSTGRES_USER=fierce
POSTGRES_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
POSTGRES_DB=fiercefitness
POSTGRES_HOST=db
POSTGRES_PORT=5432

# FastAPI Configuration
DATABASE_URL=postgresql+asyncpg://fierce:CHANGE_THIS_STRONG_PASSWORD@db:5432/fiercefitness
# Generate a strong secret key: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_SECRET_KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
SQL_ECHO=false

# Security
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500,http://127.0.0.1:5500

# Admin Seed (change this before production!)
ADMIN_EMAIL=admin@fiercefitness.com
ADMIN_PASSWORD=CHANGE_THIS_STRONG_ADMIN_PASSWORD
